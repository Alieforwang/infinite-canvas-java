<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 用户 refresh token 表 SQL（原生 MyBatis，手写便于修改学习） -->
<mapper namespace="com.infinitecanvas.mapper.UserRefreshTokenMapper">

    <resultMap id="BaseResultMap" type="com.infinitecanvas.entity.UserRefreshToken">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="token_hash" property="tokenHash"/>
        <result column="expires_at" property="expiresAt"/>
        <result column="revoked_at" property="revokedAt"/>
        <result column="user_agent" property="userAgent"/>
        <result column="ip" property="ip"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, token_hash, expires_at, revoked_at, user_agent, ip, created_at
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_refresh_token
        WHERE id = #{id}
    </select>

    <select id="selectByTokenHash" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_refresh_token
        WHERE token_hash = #{tokenHash}
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_refresh_token (user_id, token_hash, expires_at, revoked_at, user_agent, ip, created_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt}, #{revokedAt}, #{userAgent}, #{ip}, #{createdAt})
    </insert>

    <update id="updateById">
        UPDATE user_refresh_token
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="tokenHash != null">token_hash = #{tokenHash},</if>
            <if test="expiresAt != null">expires_at = #{expiresAt},</if>
            <if test="revokedAt != null">revoked_at = #{revokedAt},</if>
            <if test="userAgent != null">user_agent = #{userAgent},</if>
            <if test="ip != null">ip = #{ip},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="revokeAllByUserId">
        UPDATE user_refresh_token
        SET revoked_at = #{revokedAt}
        WHERE user_id = #{userId} AND revoked_at IS NULL
    </update>

</mapper>
